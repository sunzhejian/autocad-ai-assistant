                    LoadOnAutoCADStartup="True"
                    LoadOnCommandInvocation="True">
      <Commands GroupName="CADAI">
        <Command Global="AI" Local="AI" Description="打开 AI 助手面板" />
        <Command Global="AIUI" Local="AIUI" Description="恢复完整界面并启用启动工具" />
