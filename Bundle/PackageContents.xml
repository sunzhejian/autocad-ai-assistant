        <Command Global="AIUIRESTORE" Local="AIUIRESTORE" Description="恢复六项原始启动偏好" />
        <Command Global="AIDRAW" Local="AIDRAW" Description="执行 AI 绘图队列" />
        <Command Global="AIPLAN" Local="AIPLAN" Description="执行本地 JSON 绘图计划" />
        <Command Global="AIPERF" Local="AIPERF" Description="减少 CAD 实时预览负担" />
        <Command Global="AIPERFRESTORE" Local="AIPERFRESTORE" Description="恢复原 CAD 预览设置" />
      </Commands>
    </ComponentEntry>
  </Components>
</ApplicationPackage>
