<?xml version="1.0" encoding="utf-8"?>
<ApplicationPackage SchemaVersion="1.0"
                    AppVersion="1.6.1"
                    ProductCode="{6EACF5AB-67D7-4C08-9697-1FAD507F20B8}"
                    UpgradeCode="{702EE4A7-7764-4F4A-B1D1-34C10855F475}"
                    Name="AutoCAD AI Assistant"
                    Description="Drawing tools and on-demand AI assistant for AutoCAD 2024">
  <CompanyDetails Name="AutoCAD AI Assistant" />
  <Components Description="AI panel">
    <RuntimeRequirements OS="Win64" Platform="AutoCAD*" SeriesMin="R24.3" SeriesMax="R24.3" />
    <ComponentEntry AppName="AutoCAD.AI.Assistant"
                    ModuleName="./Contents/AutoCAD.AI.Assistant.v2.dll"
