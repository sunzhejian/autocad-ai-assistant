<UserControl x:Class="AutoCAD.AI.Assistant.Views.AiPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:AutoCAD.AI.Assistant.Views"
             mc:Ignorable="d" d:DesignWidth="430" d:DesignHeight="700"
             Background="#F5F6F8">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisible" />
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="#202124" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="Background" Value="#3B82F6" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Border" Property="Opacity" Value="0.45" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Background" Value="#E7E9ED" />
      <Setter Property="Foreground" Value="#303238" />
    </Style>
    <Style x:Key="ShortcutButton" TargetType="Button">
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="Padding" Value="9,5" />
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#34363B" />
      <Setter Property="BorderBrush" Value="#DDE0E5" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Border" Property="BorderBrush" Value="#3B82F6" />
                <Setter Property="Foreground" Value="#2563EB" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid Margin="10" PreviewMouseDown="Panel_PreviewMouseDown">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ComboBox x:Name="ModelCombo" MinHeight="32" Padding="7,3" VerticalContentAlignment="Center" ToolTip="选择模型；右键可编辑当前模型">
        <ComboBox.ContextMenu>
          <ContextMenu><MenuItem Header="编辑当前模型" Click="EditModel_Click" /></ContextMenu>
        </ComboBox.ContextMenu>
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <Button Grid.Column="1" Content="＋" ToolTip="添加模型" Style="{StaticResource SecondaryButton}" Padding="10,5" Margin="6,0,0,0" Click="AddModel_Click" />
      <Button x:Name="AttachButton" Grid.Column="2" Content="图/PDF" ToolTip="选择图片或 PDF；Ctrl+V 可粘贴图片或文件" Style="{StaticResource SecondaryButton}" Padding="8,5" Margin="6,0,0,0" Click="AttachImage_Click" />
      <Button x:Name="ShortcutToggle" Grid.Column="3" Content="指令集" Style="{StaticResource SecondaryButton}" Padding="10,5" Margin="6,0,0,0" Click="ShortcutToggle_Click" />
      <Button Grid.Column="4" Content="清空" Style="{StaticResource SecondaryButton}" Padding="10,5" Margin="6,0,0,0" Click="Clear_Click" />

      <Popup x:Name="ShortcutPopup" PlacementTarget="{Binding ElementName=ShortcutToggle}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
        <Border Width="390" MaxHeight="390" Background="White" BorderBrush="#D8DCE3" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,5,0,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Margin="2,0,0,8">
              <TextBlock Text="点击指令后，在绘图区按命令提示继续" FontSize="11" Foreground="#737984" />
              <CheckBox x:Name="RecordUsageCheck" Content="统计命令使用次数" FontSize="11" Margin="0,6,0,0" Checked="RecordUsage_Changed" Unchecked="RecordUsage_Changed" ToolTip="默认关闭；启用后仅在 AI 面板显示时统计，关闭面板即暂停。" />
            </StackPanel>
            <Grid Grid.Row="1" Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="高频指令自动置顶" FontSize="11" Foreground="#9AA0A8" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <RadioButton x:Name="SortByCount" Content="按使用次数" GroupName="ShortcutSort" FontSize="11" VerticalAlignment="Center" Checked="SortMode_Changed" />
                <RadioButton x:Name="SortByName" Content="按首字母" GroupName="ShortcutSort" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0" Checked="SortMode_Changed" />
              </StackPanel>
            </Grid>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
              <ItemsControl x:Name="ShortcutList">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource ShortcutButton}" ToolTip="{Binding Description}" Click="Shortcut_Click">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                        <TextBlock Text="{Binding Description}" Margin="5,0,0,0" Foreground="#858A93" />
                        <TextBlock Text="{Binding CountText}" Margin="4,0,0,0" Foreground="#B0B5BD" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>
      </Popup>
    </Grid>

    <Border Grid.Row="1" Background="White" BorderBrush="#E2E4E8" BorderThickness="1" CornerRadius="8" Padding="10">
      <Grid>
        <TextBlock x:Name="EmptyText" Text="输入问题开始对话" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#9AA0A8" Margin="30" IsHitTestVisible="False" />
        <ScrollViewer x:Name="MessageScroll" VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="MessageList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border x:Name="MessageBorder" Margin="0,0,0,10" Padding="10" CornerRadius="7" Background="#F0F2F5">
                  <StackPanel>
                    <TextBlock Text="{Binding Header}" FontSize="11" FontWeight="SemiBold" Foreground="#737984" Margin="0,0,0,4" />
                    <local:ChatPreviewImage SourcePath="{Binding ImagePath}" MaxHeight="220" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,6" Visibility="{Binding HasImage, Converter={StaticResource BoolToVisible}}" />
                    <TextBlock Text="{Binding DisplayContent}" TextWrapping="Wrap" FontSize="13" LineHeight="20" Foreground="#292B30" />
                  </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsUser}" Value="True">
                    <Setter TargetName="MessageBorder" Property="Background" Value="#E7F0FF" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>

    <StackPanel Grid.Row="2" Margin="0,10,0,0">
      <Border x:Name="PendingBox" Visibility="Collapsed" Background="White" BorderBrush="#D8DCE3" BorderThickness="1" CornerRadius="8" Padding="7" Margin="0,0,0,6">
        <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Image x:Name="PendingImage" Height="54" MaxWidth="70" Stretch="Uniform" HorizontalAlignment="Left" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0">
            <TextBlock x:Name="PendingTitle" Text="图片已附加，可直接发送复刻" FontSize="11" Foreground="#737984" TextWrapping="Wrap" />
            <CheckBox x:Name="DetailedImageCheck" Content="精细分块（较慢）" FontSize="11" Foreground="#737984" Margin="0,5,0,0" ToolTip="大图附加四张局部高清图；单个视图优先使用框选" />
            <CheckBox x:Name="ReusePlanCheck" Content="复用已执行计划" IsChecked="True" FontSize="11" Foreground="#737984" Margin="0,5,0,0" ToolTip="同图、同提示、同模型直接复用；重新识别时取消勾选。缓存通过执行验证，源图准确性仍需核对。" />
          </StackPanel>
          <Button x:Name="CropButton" Grid.Column="2" Content="框选" ToolTip="只复刻图片的一部分（如平面图）；PDF 框选后使用 AI 重建" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,6,0" VerticalAlignment="Center" Click="CropPending_Click" />
          <Button Grid.Column="3" Content="移除" Style="{StaticResource SecondaryButton}" Padding="8,4" VerticalAlignment="Center" Click="RemovePending_Click" />
        </Grid>
        <StackPanel x:Name="PdfOptions" Visibility="Collapsed" Margin="0,7,0,0">
          <WrapPanel VerticalAlignment="Center">
            <TextBlock Text="页码" VerticalAlignment="Center" FontSize="11" />
            <TextBox x:Name="PdfPageBox" Text="1" Width="42" Margin="6,0" Padding="3" />
            <Button x:Name="PdfPageButton" Content="切换页" Style="{StaticResource SecondaryButton}" Padding="8,4" Click="PdfPage_Click" />
          </WrapPanel>
          <ComboBox x:Name="PdfRoute" SelectedIndex="0" Margin="0,6,0,0" SelectionChanged="PdfRoute_Changed">
            <ComboBoxItem x:Name="NativePdfChoice" Content="原生导入：保留 PDF 矢量图形（无需模型）" />
            <ComboBoxItem Content="AI 重建：识别当前页，生成几何与智能标注" />
          </ComboBox>
          <WrapPanel x:Name="PdfScaleOptions" Margin="0,6,0,0">
            <TextBlock Text="纸面放大倍数" FontSize="11" VerticalAlignment="Center" />
            <TextBox x:Name="PdfScaleBox" Text="1" Width="60" Margin="6,0" Padding="3" />
            <TextBlock Text="整页含多比例视图时保持 1" FontSize="10" Foreground="#737984" VerticalAlignment="Center" />
          </WrapPanel>
          <TextBlock x:Name="PdfHint" TextWrapping="Wrap" FontSize="11" Foreground="#737984" Margin="0,5,0,0" />
        </StackPanel>
        </StackPanel>
      </Border>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Background="White" BorderBrush="#D8DCE3" BorderThickness="1" CornerRadius="8" Padding="9">
          <TextBox x:Name="InputBox" MinHeight="58" MaxHeight="130" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" PreviewKeyDown="InputBox_PreviewKeyDown" />
        </Border>
        <Button x:Name="SendButton" Grid.Column="1" Content="发送" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" VerticalAlignment="Bottom" Click="SendButton_Click" />
      </Grid>
    </StackPanel>
    <Grid Grid.Row="3" Margin="2,8,2,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="StatusText" Text="Enter 发送 · Ctrl+V 粘贴图纸图片可自动复刻 · 绘完输入 U 撤销。" TextWrapping="Wrap" FontSize="11" Foreground="#858A93" />
      <TextBlock Grid.Column="1" Text="诊断" FontSize="11" Foreground="#2563EB" Cursor="Hand" Margin="8,0,0,0" VerticalAlignment="Top" MouseLeftButtonUp="Diag_Click" ToolTip="导出运行日志，便于排查问题" />
    </Grid>
  </Grid>
</UserControl>
