<Window x:Class="AutoCAD.AI.Assistant.Views.ModelSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自定义模型" Width="540" Height="790" MinWidth="480" MinHeight="650"
        WindowStartupLocation="CenterScreen" Background="#FAFAFB" FontFamily="Microsoft YaHei UI">
  <Window.Resources>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#F0F1F3" />
      <Setter Property="BorderBrush" Value="#E2E3E6" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="11,9" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Background" Value="#F0F1F3" />
      <Setter Property="BorderBrush" Value="#E2E3E6" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="11,9" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="ActionButton" TargetType="Button">
      <Setter Property="Padding" Value="18,9" />
      <Setter Property="Background" Value="#202124" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
  </Window.Resources>
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,18">
      <TextBlock Text="自定义模型" FontSize="24" FontWeight="SemiBold" Foreground="#202124" />
      <TextBlock Text="添加兼容 OpenAI Chat Completions 的模型服务" FontSize="12" Foreground="#858A93" Margin="0,6,0,0" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock FontSize="13" FontWeight="SemiBold"><Run Foreground="#E5484D">* </Run>API 格式</TextBlock>
        <ComboBox SelectedIndex="0" Margin="0,8,0,18" Padding="8,7" Background="#F0F1F3">
          <ComboBoxItem Content="OpenAI Chat Completions 格式" />
        </ComboBox>

        <Grid>
          <TextBlock FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"><Run Foreground="#E5484D">* </Run>自定义请求地址</TextBlock>
          <CheckBox x:Name="FullUrlCheck" Content="完整 URL" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="FullUrl_Checked" Unchecked="FullUrl_Checked" />
        </Grid>
        <TextBlock x:Name="UrlHint" Text="填写服务基础地址，/chat/completions 会自动追加到末尾。" TextWrapping="Wrap" FontSize="11" Foreground="#92969E" Margin="0,6,0,8" />
        <TextBox x:Name="UrlBox" ToolTip="例如 https://api.openai.com/v1" />

        <TextBlock FontSize="13" FontWeight="SemiBold" Margin="0,18,0,0"><Run Foreground="#E5484D">* </Run>模型 ID</TextBlock>
        <TextBox x:Name="ModelIdBox" Margin="0,8,0,0" ToolTip="例如 gpt-4o-mini" />

        <Grid Margin="0,18,0,0">
          <TextBlock Text="模型展示名称" FontSize="13" FontWeight="SemiBold" />
          <TextBlock x:Name="NameCount" Text="0/64" HorizontalAlignment="Right" Foreground="#92969E" FontSize="11" />
        </Grid>
        <TextBlock Text="未设置时默认显示模型 ID。" FontSize="11" Foreground="#92969E" Margin="0,5,0,8" />
        <TextBox x:Name="DisplayNameBox" MaxLength="64" TextChanged="DisplayNameBox_TextChanged" />

        <TextBlock FontSize="13" FontWeight="SemiBold" Margin="0,18,0,0"><Run Foreground="#E5484D">* </Run>API 密钥</TextBlock>
        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <PasswordBox x:Name="ApiKeyBox" />
          <TextBox x:Name="ApiKeyTextBox" Visibility="Collapsed" />
          <CheckBox Grid.Column="1" Content="显示" Margin="10,0,0,0" VerticalAlignment="Center" Checked="ShowKey_Checked" Unchecked="ShowKey_Checked" />
        </Grid>
        <TextBlock x:Name="KeyHint" Text="密钥使用 Windows DPAPI 按当前用户加密保存。" TextWrapping="Wrap" FontSize="11" Foreground="#92969E" Margin="0,6,0,0" />

        <Expander Header="高级配置" Margin="0,20,0,4" Foreground="#3E4045">
          <StackPanel Margin="0,12,0,0">
            <TextBlock Text="推理预算（可选）" FontSize="12" />
            <ComboBox x:Name="ReasoningEffortBox" SelectedIndex="0" Margin="0,8,0,0" Padding="8,7">
              <ComboBoxItem Content="服务默认" Tag="" />
              <ComboBoxItem Content="不使用推理（none）" Tag="none" />
              <ComboBoxItem Content="最少（minimal）" Tag="minimal" />
              <ComboBoxItem Content="较低（low）" Tag="low" />
              <ComboBoxItem Content="中等（medium）" Tag="medium" />
              <ComboBoxItem Content="较高（high）" Tag="high" />
              <ComboBoxItem Content="很高（xhigh）" Tag="xhigh" />
              <ComboBoxItem Content="最大（max）" Tag="max" />
            </ComboBox>
            <TextBlock Text="服务默认保留原有行为。较低预算可能减少等待，也可能影响复杂图准确率；支持范围由服务和模型决定。" TextWrapping="Wrap" FontSize="11" Foreground="#92969E" Margin="0,6,0,14" />
            <TextBlock Text="系统提示词（可选）" FontSize="12" />
            <TextBox x:Name="SystemPromptBox" Height="90" Margin="0,8,0,0" MaxLength="4000" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
          </StackPanel>
        </Expander>
      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Row="2" Margin="0,18,0,0">
      <TextBlock Text="保存时不会发起模型请求。" VerticalAlignment="Center" FontSize="11" Foreground="#858A93" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="重置" Background="#E7E8EA" Foreground="#303238" Style="{StaticResource ActionButton}" Margin="0,0,10,0" Click="Reset_Click" />
        <Button x:Name="SaveModelButton" Content="添加模型" Style="{StaticResource ActionButton}" Click="Add_Click" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
