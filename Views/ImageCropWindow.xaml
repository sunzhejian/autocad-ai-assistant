<Window x:Class="AutoCAD.AI.Assistant.Views.ImageCropWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="框选复刻区域" Width="860" Height="660" WindowStartupLocation="CenterOwner"
        Background="#F5F6F8" ResizeMode="CanResize">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="White" BorderBrush="#D8DCE3" BorderThickness="1" CornerRadius="6">
      <Grid x:Name="Host" ClipToBounds="True">
        <Image x:Name="Preview" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <Canvas x:Name="Overlay" Background="Transparent" MouseLeftButtonDown="Overlay_MouseDown" MouseMove="Overlay_MouseMove" MouseLeftButtonUp="Overlay_MouseUp">
          <Rectangle x:Name="Selection" Stroke="#2563EB" StrokeThickness="2" Fill="#332563EB" Visibility="Collapsed" IsHitTestVisible="False" />
        </Canvas>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="0,10,0,0">
      <TextBlock x:Name="Hint" Text="拖动框选要复刻的区域；不框选则使用整张图" Foreground="#737984" FontSize="11" VerticalAlignment="Center" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="全图" Padding="12,6" Margin="0,0,8,0" Click="Reset_Click" />
        <Button Content="取消" Padding="12,6" Margin="0,0,8,0" Click="Cancel_Click" />
        <Button Content="确定" Padding="14,6" Background="#202124" Foreground="White" Click="Ok_Click" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
